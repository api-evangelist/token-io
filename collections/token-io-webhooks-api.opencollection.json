{
  "opencollection": "1.0.0",
  "info": {
    "name": "Token.io's Open Banking API for TPPs Account on File Webhooks API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get webhook config",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.token.io/webhook/config",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "The `GET /webhook/config` endpoint retrieves the webhook configuration."
        },
        {
          "info": {
            "name": "Set webhook config",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.token.io/webhook/config",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "The `PUT /webhook/config` endpoint sets the webhook configuration."
        },
        {
          "info": {
            "name": "Delete webhook config",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.token.io/webhook/config",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "The `DELETE /webhook/config` endpoint deletes the webhook configuration."
        }
      ]
    }
  ],
  "bundled": true
}