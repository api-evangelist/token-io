{
  "opencollection": "1.0.0",
  "info": {
    "name": "Token.io's Open Banking API for TPPs Account on File Verification API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Verification",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Initiate an account verification check",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.token.io/account-verifications",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This endpoint allows clients to verify whether the provided account details (such as sort code and account number or IBAN) match the name of the intended account holder, whether an individual or a business"
        }
      ]
    }
  ],
  "bundled": true
}