{
  "openapi": "3.0.0",
  "info": {
    "title": "Token Bank Integration API",
    "description": "This API is for banks integrating with Token",
    "contact": {
      "email": "service@token.io"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "version": "1.0.6"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "accounts",
      "description": "Accounts Service - Implemented by bank to support access to account information."
    },
    {
      "name": "transfers",
      "description": "Transfers Service - Implemented by bank to support payment initiation."
    },
    {
      "name": "health",
      "description": "Health Check Endpoints."
    }
  ],
  "paths": {
    "/accounts/{bankAccountId}/balance": {
      "get": {
        "tags": [
          "accounts"
        ],
        "summary": "Get account balance",
        "description": "Returns the current balance of the given account.",
        "operationId": "getAccountBalance",
        "parameters": [
          {
            "name": "token-consent-id",
            "in": "header",
            "description": "The Consent/Token indentifier",
            "required": false,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "token-tpp-id",
            "in": "header",
            "description": "The TPP indentifier",
            "required": false,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "token-account-holder-id",
            "in": "header",
            "description": "The account holder indentifier",
            "required": false,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bankAccountId",
            "in": "path",
            "description": "The bank account identifier.",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The bank acccount balance.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Balance"
                }
              }
            }
          },
          "404": {
            "description": "The specified account was not found."
          },
          "default": {
            "description": "Unexpected error"
          }
        },
        "security": [
          {
            "BasicAuth": []
          },
          {
            "Bearer": []
          }
        ],
        "x-hideTryItPanel": true
      }
    },
    "/accounts/{bankAccountId}/transactions": {
      "get": {
        "tags": [
          "accounts"
        ],
        "summary": "Get account transactions",
        "description": "Returns the transactions that occurred in the given bank account.",
        "operationId": "getAccountTransactions",
        "parameters": [
          {
            "name": "token-consent-id",
            "in": "header",
            "description": "The Consent/Token indentifier",
            "required": false,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bankAccountId",
            "in": "path",
            "description": "The bank account identifier.",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "The number of results per page.",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "The result offset for pagination.",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "description": "A filter for start booking date of transactions",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "A filter for end booking date of transactions",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The transaction.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionsPage"
                }
              }
            }
          },
          "401": {
            "description": "Access token is missing or invalid"
          },
          "404": {
            "description": "The specified account was not found."
          },
          "default": {
            "description": "Unexpected error"
          }
        },
        "security": [
          {
            "BasicAuth": []
          },
          {
            "Bearer": []
          }
        ],
        "x-hideTryItPanel": true
      }
    },
    "/accounts/{bankAccountId}/transactions/{transactionId}": {
      "get": {
        "tags": [
          "accounts"
        ],
        "summary": "Get account transactions for given bank",
